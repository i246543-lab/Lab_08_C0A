module program_counter( clk, reset, truncated_addr, pc_out);
input clk, reset;
output [3:0] truncated_addr;
output reg [31:0] pc_out;
always @ (posedge clk or posedge reset)
begin 
    if(reset)
      pc_out <= 32'h00000000;
    else
     pc_out <= pc_out + 32'd4;
end
assign truncated_addr= pc_out[5:2]; //lower bits truncation
endmodule
module instruction_memory(addr, instruction);
input [3:0] addr;
output reg [31:0] instruction;
reg [31:0] memory [0:15];
initial 
begin
memory[0]= 32'h00000000;
memory[1]= 32'h00000001;
memory[2]= 32'h00000010;
memory[3]= 32'h00000011;
memory[4]= 32'h00000100;
memory[5]= 32'h00000101;
memory[6]= 32'h00000110;
memory[7]= 32'h00000111;
memory[8]= 32'h00001000;
memory[9]= 32'h00001001;
memory[10]= 32'h00001010;
memory[11]= 32'h00001011;
memory[12]= 32'h00001100;
memory[13]= 32'h00001101;
memory[14]= 32'h00001110;
memory[15]= 32'h00001111;
end
always @ (*) 
begin
    if ( addr < 16)
      instruction= memory[addr];
    else 
      instruction= 32'h00000000;
end
endmodule
module tb_program_counter();
reg clk, reset;
reg [3:0] truncated_addr;
wire [31:0] pc_out;
wire [31:0] instruction;
program_counter pc(.clk(clk), .reset(reset), .truncated_addr(truncated_addr), .pc_out(pc_out));
instruction_memory im(.addr(truncated_addr), .instruction(instruction));
always begin
#5 clk= ~clk;
end
initial
begin
clk=0;
reset=0;
reset=1;
#10 reset=0;
end
endmodule

