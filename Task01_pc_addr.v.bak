module program_counter( clk, reset, addr, pc_out);
input clk, reset;
input [3:0] addr;
output reg [3:0] pc_out;
always @ (posedge clk or posedge reset)
begin 
    if(reset)
      pc_out <= 4'b0000;
    else
     pc_out <= addr;
end
endmodule
module instruction_memory(addr, instruction);
input [3:0] addr;
output reg [3:0] instruction;
reg [3:0] memory [0:15];
initial 
begin
memory[0]= 4'b0000;
memory[1]= 4'b0001;
memory[2]= 4'b0010;
memory[3]= 4'b0011;
memory[4]= 4'b0100;
memory[5]= 4'b0101;
memory[6]= 4'b0110;
memory[7]= 4'b0111;
memory[8]= 4'b1000;
memory[9]= 4'b1001;
memory[10]= 4'b1010;
memory[11]= 4'b1011;
memory[12]= 4'b1100;
memory[13]= 4'b1101;
memory[14]= 4'b1110;
memory[15]= 4'b1111;
end
always @ (addr) 
begin
instruction= memory[addr];
end
endmodule
module tb_program_counter();
reg clk, reset;
reg [3:0] addr;
wire [3:0] pc_out;
wire [3:0] instruction;
program_counter pc(.clk(clk), .reset(reset), .addr(addr), .pc_out(pc_out));
instruction_memory im(.addr(pc_out), .instruction(instruction));
always begin
#5 clk= ~clk;
end
initial
begin
clk=0;
reset=0;
addr=0;
reset=1;
#10 reset=0;
#10 addr=1;
#10 addr=2;
#10 addr=3;
#10 addr=0;
end
endmodule


